MINDTRACE_APP_NAME=MindTrace API
MINDTRACE_ENVIRONMENT=development
MINDTRACE_DATABASE_URL=sqlite:///./mindtrace.db
MINDTRACE_CORS_ORIGINS=http://localhost:5173
MINDTRACE_JWT_SECRET=replace-with-a-long-random-secret
MINDTRACE_JWT_ALGORITHM=HS256
MINDTRACE_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Required to self-register a counsellor account (leave empty to disable).
MINDTRACE_COUNSELLOR_INVITE_CODE=
# Enables POST /api/admin/wipe. Never enable outside local development.
MINDTRACE_ALLOW_DATA_WIPE=false
MINDTRACE_CONSENT_NOTICE_VERSION=2026-09-v1
